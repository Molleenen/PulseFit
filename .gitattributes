# Set default behavior to auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Swift & Scripting Source Files
*.swift text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.plist text eol=lf

# Xcode Project & Workspace Files (Merge drivers & LFS handling)
*.pbxproj text eol=lf
*.xcworkspacedata text eol=lf
*.xcscheme text eol=lf

# Binary Assets
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.car binary
*.xcassets binary
